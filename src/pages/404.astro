---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { productCategories } from '../data/site';
---

<Layout
  title="페이지를 찾을 수 없습니다 | 墨泰 연마재"
  description="요청하신 페이지를 찾을 수 없습니다. 제품 카탈로그로 돌아가거나, 산업별 솔루션을 탐색하거나, 墨泰로 바로 견적을 요청해 주십시오."
  noindex
>
  <section class="page-hero page-hero--simple">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">404 에러</span>
      <h1>요청하신 페이지를 찾을 수 없습니다</h1>
      <p>
        페이지가 이동했거나 링크가 잘못 입력되었을 수 있습니다. 아래 단축 경로를 통해
        제품 카탈로그로 이동하거나, 바로 견적을 요청해 주십시오.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-heading section-heading--center">
        <span class="eyebrow">빠른 바로가기</span>
        <h2>어디로 이동할까요?</h2>
      </div>

      <div class="catalog-grid">
        {
          productCategories.map((product) => (
            <article class="catalog-card">
              <div class="catalog-card__media">
                <img src={product.image} alt={`墨泰 ${product.name}`} width="560" height="420" loading="lazy" />
              </div>
              <div class="catalog-card__body">
                <h2><a href={`/products/${product.slug}`}>{product.name}</a></h2>
                <p>{product.description}</p>
                <a class="button button--outline button--small" href={`/products/${product.slug}`}>
                  전체 스펙 보기
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="catalog-guide">
        <div>
          <span class="eyebrow">찾는 내용을 찾지 못하셨나요?</span>
          <h2>스펙을 보내 주시면 안내해 드립니다</h2>
          <p>
            제품 종류, 규격, 수량, 배송 목적지를 알려 주십시오. 요청 사항을 검토한 후
            운영 방식에 가장 적합한 스펙을 제안해 드립니다.
          </p>
        </div>
        <div class="catalog-guide__actions">
          <a class="button button--primary" href="/quote">견적 요청</a>
          <a class="button button--outline" href="/contact">문의하기</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="도움받아 이동하기" text="WhatsApp으로 직접 연락해 주시면, 적합한 제품 또는 스펙으로 안내해 드립니다." />
</Layout>
