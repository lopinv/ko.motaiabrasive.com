---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, productCategories } from '../data/site';
import { models } from '../data/models';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '견적 요청', href: '/quote' },
];

const selectedProduct = Astro.url.searchParams.get('product') ?? '';
const selectedModel = models.find((model) => model.slug === selectedProduct);
const initialCategory = selectedModel?.categorySlug ?? '';

const steps = [
  { id: 'product', title: '제품', hint: '필요한 제품은?' },
  { id: 'spec', title: '스펙', hint: '규격과 수량' },
  { id: 'delivery', title: '공급', hint: '배송처와 주기' },
  { id: 'contact', title: '연락처', hint: '견적 및 회신을 위해' },
];
---

<Layout
  title="연마재 견적 요청 | 墨泰 공장"
  description="墨泰 견적 요청은 4단계: 제품 선택, 스펙과 수량 지정, 배송처와 주기 입력, 연락처 남기기. 1영업일 이내에 명확한 견적으로 회신드립니다."
  image="/images/factory.jpg"
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="quote-funnel">
    <header class="funnel__head">
      <div class="container">
        <div class="funnel__intro">
          <span class="eyebrow eyebrow--light">견적 요청 · 4단계</span>
          <h1>필요하신 내용을 알려 주시면, 명확한 견적으로 회신드립니다</h1>
          <p>
            각 단계는 간결하게 설계되었습니다. 단계별 필수 항목을 작성하고, 해당되지 않는
            항목은 비워 두십시오 — 스펙을 검토하고 필요 시 질문한 뒤 견적을 보내 드립니다.
          </p>
        </div>

        <ol class="funnel__progress" data-funnel-progress>
          {
            steps.map((step, index) => (
              <li class:list={{ 'is-active': index === 0 }} data-step={index}>
                <span class="funnel__progress-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="funnel__progress-text">
                  <strong>{step.title}</strong>
                  <small>{step.hint}</small>
                </span>
                {index < steps.length - 1 && <span class="funnel__progress-bar" aria-hidden="true"></span>}
              </li>
            ))
          }
        </ol>
      </div>
    </header>

    <div class="container funnel__body">
      <form
        class="funnel-form"
        action="https://form.lopins.cn/lopinx@duck.com/ad7aa0dd52e0afa55f85f7b2"
        method="POST"
        data-funnel-form
      >
        <input type="hidden" name="_subject" value="견적 요청 - MoTai Abrasives" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="/thankyou" />
        <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />


        <section class="funnel-step" data-panel="0" aria-labelledby="step-title-0">
          <div class="funnel-step__head">
            <span class="funnel-step__num">01</span>
            <div>
              <h2 id="step-title-0">어떤 제품군이 필요하신가요?</h2>
              <p>용도에 맞는 제품을 선택하고, 규격이 정해져 있으면 선택해 주십시오.</p>
            </div>
          </div>

          <div class="quickpick quickpick--4" role="radiogroup" aria-label="제품군" data-quickpick="category">
            {
              productCategories.map((product) => (
                <label class:list={['quickpick__item']} data-choice>
                  <input
                    type="radio"
                    name="product_category"
                    value={product.name}
                    required
                    checked={initialCategory === product.slug}
                  />
                  <span class="quickpick__item-label">
                    <strong>{product.name}</strong>
                    <small>{product.applications.slice(0, 2).join(' · ')}</small>
                  </span>
                </label>
              ))
            }
          </div>

          <label class="field field--full">
            <span>구체적인 규격 (정해져 있는 경우)</span>
            <select name="model_slug" data-model-select>
              <option value="">미정 — 나중에 스펙을 기재하겠습니다</option>
              {
                models.map((model) => (
                  <option value={model.name} selected={model.slug === selectedProduct}>
                    {model.name} — {model.sizeAr}
                  </option>
                ))
              }
            </select>
          </label>
        </section>


        <section class="funnel-step" data-panel="1" aria-labelledby="step-title-1" hidden>
          <div class="funnel-step__head">
            <span class="funnel-step__num">02</span>
            <div>
              <h2 id="step-title-1">그릿 등급과 수량은 어느 정도인가요?</h2>
              <p>필요에 가장 가까운 그릿 등급을 선택해 주십시오 — 정확한 등급은 생산 전에 확인합니다.</p>
            </div>
          </div>

          <div class="quickpick quickpick--4" role="radiogroup" aria-label="그릿 등급" data-quickpick="grit">
            <label class="quickpick__item">
              <input type="radio" name="grit" value="거친 (36-80)" required />
              <span class="quickpick__item-label">
                <strong>거친 36–80</strong>
                <small>산화물·도막 고속 제거</small>
              </span>
            </label>
            <label class="quickpick__item">
              <input type="radio" name="grit" value="중간 (100-180)" />
              <span class="quickpick__item-label">
                <strong>중간 100–180</strong>
                <small>일반 연마 및 재질(표면 두께) 제거</small>
              </span>
            </label>
            <label class="quickpick__item">
              <input type="radio" name="grit" value="부드러운 (220-400)" />
              <span class="quickpick__item-label">
                <strong>부드러운 220–400</strong>
                <small>마감 및 도장 전 준비</small>
              </span>
            </label>
            <label class="quickpick__item">
              <input type="radio" name="grit" value="극세 (500+)" />
              <span class="quickpick__item-label">
                <strong>극세 500–5000</strong>
                <small>최종 마감 및 광택 처리</small>
              </span>
            </label>
          </div>

          <div class="funnel-fields">
            <label class="field">
              <span>필요 수량 *</span>
              <input name="quantity" type="text" required placeholder="예: 5,000개 / 100박스" />
            </label>

            <label class="field">
              <span>OEM 또는 특수 포장이 필요하나요?</span>
              <select name="oem">
                <option value="불필요">불필요, 표준 공급으로</option>
                <option value="필요, 자체 브랜드">필요, 자체 브랜드</option>
                <option value="검토 중">검토 중</option>
              </select>
            </label>

            <label class="field field--full">
              <span>가공 소재와 원하는 마감 결과 *</span>
              <textarea name="application" rows="3" required placeholder="가공 소재(목재, 알루미늄, 강철)와 원하는 결과(녹 제거, 광택, 도장 전)를 기술해 주십시오."></textarea>
            </label>

            <label class="field field--full">
              <span>기계 및 고정 방식</span>
              <input name="machine" type="text" placeholder="기종, 이음매(스플라이스) 방식 또는 고정 시스템" />
            </label>
          </div>
        </section>


        <section class="funnel-step" data-panel="2" aria-labelledby="step-title-2" hidden>
          <div class="funnel-step__head">
            <span class="funnel-step__num">03</span>
            <div>
              <h2 id="step-title-2">어디로, 어떤 주기로 공급할까요?</h2>
              <p>배송처와 주문 주기가 견적 내 운송 계획과 공급 조건을 결정합니다.</p>
            </div>
          </div>

          <div class="funnel-fields">
            <label class="field">
              <span>배송 대상 국가 *</span>
              <select name="destination" data-destination-select required>
                <option value="" disabled selected>국가 선택</option>
                <option>한국</option>
                <option>일본</option>
                <option>중국</option>
                <option>베트남</option>
                <option>태국</option>
                <option>인도네시아</option>
                <option>말레이시아</option>
                <option>필리핀</option>
                <option>싱가포르</option>
                <option>인도</option>
                <option>사우디아라비아</option>
                <option>아랍에미리트</option>
                <option>카타르</option>
                <option>쿠웨이트</option>
                <option>바레인</option>
                <option>오만</option>
                <option>이집트</option>
                <option>남아프리카</option>
                <option>브라질</option>
                <option>멕시코</option>
                <option>기타 국가</option>
              </select>
            </label>

            <label class="field">
              <span>예상 주문 주기</span>
              <select name="frequency">
                <option value="시범 주문 / 샘플">시범 주문 / 샘플</option>
                <option value="1회성 주문">1회성 주문</option>
                <option value="월 정기 공급">월 정기 공급</option>
                <option value="분기 정기 공급">분기 정기 공급</option>
              </select>
            </label>

            <label class="field field--full">
              <span>비고: 인도 일정, 검사 조건 또는 특별 요구사항</span>
              <textarea name="notes" rows="3" placeholder="예: 로트별 적합증명서(CoC) 필요, 45일 이내 인도."></textarea>
            </label>
          </div>
        </section>


        <section class="funnel-step" data-panel="3" aria-labelledby="step-title-3" hidden>
          <div class="funnel-step__head">
            <span class="funnel-step__num">04</span>
            <div>
              <h2 id="step-title-3">어떻게 연락드릴까요?</h2>
              <p>선택하신 채널로 견적을 보내 드립니다. 정보는 다른 목적으로 사용하지 않습니다.</p>
            </div>
          </div>

          <div class="funnel-fields">
            <label class="field">
              <span>이름 *</span>
              <input name="name" type="text" required autocomplete="name" placeholder="성명" />
            </label>

            <label class="field">
              <span>회사명 *</span>
              <input name="company" type="text" required autocomplete="organization" placeholder="회사명" />
            </label>

            <label class="field">
              <span>이메일 *</span>
              <input name="email" type="email" required autocomplete="email" placeholder="name@company.com" dir="ltr" />
            </label>

            <label class="field">
              <span>WhatsApp / 전화 *</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="국가코드 포함" dir="ltr" />
            </label>
          </div>

          <div class="quickpick quickpick--3" role="radiogroup" aria-label="선호 연락 언어" data-quickpick="lang">
            <label class="quickpick__item">
              <input type="radio" name="preferred_contact" value="WhatsApp / 한국어" checked />
              <span class="quickpick__item-label">
                <strong>WhatsApp — 한국어</strong>
                <small>채팅으로 가장 빠른 회신</small>
              </span>
            </label>
            <label class="quickpick__item">
              <input type="radio" name="preferred_contact" value="이메일" />
              <span class="quickpick__item-label">
                <strong>이메일</strong>
                <small>파일·상세 정보 전달에 적합</small>
              </span>
            </label>
            <label class="quickpick__item">
              <input type="radio" name="preferred_contact" value="전화 / English" />
              <span class="quickpick__item-label">
                <strong>전화 — English</strong>
                <small>직통 전화 이용 시</small>
              </span>
            </label>
          </div>

          <label class="funnel-consent">
            <input name="consent" type="checkbox" required />
            <span>제출 데이터가 요청에 대한 회신에 사용되어도 동의합니다. <a href="/privacy">개인정보 처리방침</a>에 따릅니다.</span>
          </label>

          <label class="field field--full" data-return-url-field>
            <span>제출 후 돌아가고 싶은 페이지 URL (선택)</span>
            <input name="return_url" type="url" placeholder="https://ko.motaiabrasive.com/products/flap-discs" dir="ltr" />
            <small class="fine-print">비워 두시면 확인 페이지로 이동하며, 같은 도메인의 주소를 입력하시면 해당 페이지로 직접 되돌아갑니다.</small>
          </label>
        </section>


        <div class="funnel-actions">
          <button class="button button--outline" type="button" data-funnel-prev disabled>이전</button>
          <span class="funnel-actions__hint" data-funnel-hint>1단계 / 4</span>
          <div class="funnel-actions__next">
            <button class="button button--primary" type="button" data-funnel-next>다음</button>
            <button class="button button--accent" type="submit" data-funnel-submit hidden>
              견적 요청 보내기
            </button>
          </div>
        </div>

        <div class="funnel-status" data-funnel-status role="status" aria-live="polite"></div>
      </form>


      <aside class="funnel-aside">
        <div class="funnel-card">
          <h2 class="funnel-card__title">더 빠른 채널을 원하시나요?</h2>
          <p>WhatsApp 또는 이메일로 직접 보내 주십시오. 양식은 필요하지 않습니다.</p>
          <a class="button button--whatsapp button--block" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener nofollow">
            WhatsApp 직접 연락
          </a>
          <a class="button button--outline button--block" href={`mailto:${SITE.email}`} dir="ltr">{SITE.email}</a>
        </div>

        <div class="funnel-card funnel-card--soft">
          <h2 class="funnel-card__title">제출 후 어떤 절차가 진행되나요?</h2>
          <ol class="funnel-pipeline">
            <li><strong>1차 검토</strong><span>스펙 완료 여부를 확인하고, 필요 시 간결한 기술 질문을 드립니다.</span></li>
            <li><strong>상업 견적</strong><span>단가, 최소 주문 수량(MOQ), 포장·공급 조건.</span></li>
            <li><strong>샘플 / 제안</strong><span>샘플 또는 인증서가 필요하시면 절차 내에서 준비해 드립니다.</span></li>
          </ol>
          <p class="fine-print">
            제출 완료 후 <a href="/thankyou">확인 페이지</a>로 이동합니다
            — 마지막 단계의 선택 항목에 페이지 주소를 입력하시면 해당 페이지로 직접 되돌아갑니다.
          </p>
        </div>

        <div class="funnel-card funnel-card--meta">
          <h2 class="funnel-card__title">참고 정보</h2>
          <dl class="spec-dl">
            <div><dt>회신</dt><dd>1영업일 이내</dd></div>
            <div><dt>공장</dt><dd dir="ltr">중국 후베이성 시안닝시</dd></div>
            <div><dt>언어</dt><dd dir="ltr">한국어 · EN · 중국어</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <script>
    const form = document.querySelector('[data-funnel-form]');
    const steps = form ? [...form.querySelectorAll<HTMLElement>('[data-panel]')] : [];
    const progressItems = form ? [...form.querySelectorAll<HTMLElement>('[data-step]')] : [];
    const prevBtn = form?.querySelector<HTMLButtonElement>('[data-funnel-prev]');
    const nextBtn = form?.querySelector<HTMLButtonElement>('[data-funnel-next]');
    const submitBtn = form?.querySelector<HTMLButtonElement>('[data-funnel-submit]');
    const hint = form?.querySelector<HTMLElement>('[data-funnel-hint]');
    const status = form?.querySelector<HTMLElement>('[data-funnel-status]');
    let current = 0;

    const render = () => {
      steps.forEach((section, index) => {
        section.hidden = index !== current;
      });

      progressItems.forEach((item, index) => {
        item.classList.toggle('is-active', index === current);
        item.classList.toggle('is-done', index < current);
      });

      if (prevBtn) prevBtn.disabled = current === 0;
      if (hint) hint.textContent = `${current + 1}단계 / ${steps.length}`;
      if (nextBtn) nextBtn.hidden = current === steps.length - 1;
      if (submitBtn) submitBtn.hidden = current !== steps.length - 1;
    };

    const validForCurrent = () => {
      const section = steps[current];
      if (!section) return true;
      const inputs = section.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input:not([type="hidden"]):not(.honeypot), select, textarea'
      );

      for (const input of inputs) {
        if (input.type === 'radio') {
          const group = section.querySelectorAll<HTMLInputElement>(`input[name="${input.name}"]`);
          const anyChecked = [...group].some((item) => item.checked);
          if (!anyChecked) return false;
        } else if (input.required && !input.reportValidity()) {
          return false;
        }
      }

      return true;
    };

    nextBtn?.addEventListener('click', () => {
      if (!validForCurrent()) {
        (form as HTMLFormElement)?.reportValidity?.();
        return;
      }

      current = Math.min(current + 1, steps.length - 1);
      render();
      form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    prevBtn?.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      render();
    });

    const returnUrl = form?.querySelector<HTMLInputElement>('[name="return_url"]');
    const nextField = form?.querySelector<HTMLInputElement>('[name="_next"]');

    form?.addEventListener('submit', (event) => {
      if (!(form as HTMLFormElement).checkValidity()) {
        event.preventDefault();
        (form as HTMLFormElement).reportValidity();
        return;
      }

      // 제출 후 이동: 기본 /thankyou; return_url이 같은 도메인인 경우 /thankyou?from=<출처 페이지> (오픈 리다이렉트 방지)
      if (returnUrl && nextField) {
        const raw = returnUrl.value.trim();
        if (raw) {
          try {
            const u = new URL(raw, location.origin);
            const target = u.pathname + u.search;
            if (u.origin === location.origin && target !== '/') {
              nextField.value = `/thankyou?from=${encodeURIComponent(target)}`;
            }
          } catch {
            /* 유효하지 않은 URL → 기본 /thankyou 유지 */
          }
        }
      }

      if (status) status.textContent = '제출 중…';
    });

    render();
  </script>
</Layout>
