---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqItem from '../../components/FaqItem.astro';
import StickyQuote from '../../components/StickyQuote.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { productCategories } from '../../data/site';
import { getModelByCategory } from '../../data/models';

export function getStaticPaths() {
  return productCategories.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = productCategories.filter((item) => item.slug !== product.slug).slice(0, 3);
const categoryModels = getModelByCategory(product.slug);
const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '제품', href: '/products' },
  { name: product.name, href: `/products/${product.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: new URL(product.image, Astro.site).href,
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: 'Abrasive Products',
  additionalProperty: product.specs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${product.name} | 스펙 및 공급 | 墨泰`}
  description={`墨泰의 ${product.name}: 용도, 레퍼런스 스펙, 가용 옵션, 구매자 질문 — 요청에 가장 적합한 제품 선택에 도움.`}
  image={product.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">墨泰 제품군</span>
        <h1>{product.title}</h1>
        <p>{product.description}</p>
        <ul class="hero__trust">
          <li>생산 전 스펙 확인</li>
          <li>요청 기반 샘플 지원</li>
          <li>OEM 옵션</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${product.slug}`}>견적 요청</a>
          <a class="button button--ghost" href="#specs">스펙 확인</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={product.image} alt={`墨泰 공장 ${product.name}`} width="680" height="510" />
        <figcaption>스펙 확정 후 상업용 포장 또는 자체 브랜드로 공급할 수 있습니다.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">이 제품을 언제 사용하나요?</span>
          <h2>마감 및 표면 가공에 적합</h2>
          <p>
            {product.name}은 마감 단계에서 재현 가능한 결과를 요구하는 프로젝트에 적합합니다.
            제품 선택은 가공 소재·기종·요구 등급 확인에서 시작되며, 이후 작업 방식과
            예상 수량에 맞춰 스펙을 조정합니다.
          </p>
          <ul class="check-list check-list--large">
            <li>기종과 고정 방식에 맞는 형상과 규격 선택</li>
            <li>제거·마감 단계에 맞는 그릿 등급 또는 소재 지정</li>
            <li>베이스 종류와 구매자 장비의 호환성 확인</li>
            <li>변환 단계 전 수량과 포장 확정</li>
          </ul>
        </div>

        <div class="content-block" id="specs">
          <span class="eyebrow">레퍼런스 스펙</span>
          <h2>견적 요청 준비에 도움이 되는 기술 정보</h2>
          <div class="table-wrap">
            <table>
              <caption>{product.name}의 일반 스펙. 최종 스펙은 구매자와 함께 검토합니다.</caption>
              <thead><tr><th>항목</th><th>설명</th></tr></thead>
              <tbody>
                {product.specs.map(([name, value]) => <tr><th scope="row">{name}</th><td>{value}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            최종 요건은 적용 분야·기종·수량에 따라 달라집니다. 수량 확정 전 정확한 스펙과
            가용성을 확인하시려면 문의해 주십시오.
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">공급 가능 규격</span>
          <h2>기기에 맞는 규격을 선택하세요</h2>
          <p>
            각 규격마다 가용 그릿 등급, 베이스 종류, 고정 방식을 명시하여 추측 없이
            견적 요청을 준비할 수 있습니다.
          </p>
          <div class="model-list">
            {
              categoryModels.length ? (
                categoryModels.map((model) => (
                  <a class="model-list__item" href={`/products/models/${model.slug}`}>
                    <img src={model.image} alt="" width="96" height="72" loading="lazy" />
                    <span>
                      <strong>{model.name}</strong>
                      <small>{model.gritRange.length}개 그릿 등급 · {model.backing}</small>
                    </span>
                    <span class="model-list__arrow">→</span>
                  </a>
                ))
              ) : (
                <p class="model-list__empty">
                  이 제품군은 요구 사양에 맞춰 공급됩니다 — 기기에 맞는 규격과 등급을 견적으로
                  보내 주시면, 생산 전 가용성을 확인해 드립니다.
                </p>
              )
            }
          </div>
        </div>

        <div class="content-block">
          <span class="eyebrow">자주 묻는 질문</span>
          <h2>연마재 구매자의 질문</h2>
          <div class="faq-list">
            {product.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={product.name} />
        <div class="sidebar-card">
          <h3>주문에 유용한 정보</h3>
          <ul class="check-list">
            <li>제품 종류와 규격 또는 지름</li>
            <li>등급 또는 그릿 종류</li>
            <li>기종과 고정 방식</li>
            <li>수량과 배송 목적지</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">그릿 가이드 보기 <span>→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">관련 제품</span>
          <h2>주문에 적합할 수 있는 제품</h2>
        </div>
        <a class="button button--outline" href="/products">전체 제품 보기</a>
      </div>
      <div class="related-grid">
        {
          related.map((item) => (
            <a class="related-card" href={`/products/${item.slug}`}>
              <img src={item.image} alt="" width="320" height="220" loading="lazy" />
              <div><h3>{item.name}</h3><p>{item.description}</p><span>제품 보기 →</span></div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={product.slug} />
    </div>
  </section>

  <CtaBand
    title={`${product.name} 견적이 필요하신가요?`}
    text="규격, 수량, 용도를 보내 주십시오. 스펙을 검토한 후 명확한 견적을 준비해 드립니다."
  />
</Layout>
