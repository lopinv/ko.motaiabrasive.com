---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaBand from '../../../components/CtaBand.astro';
import FaqItem from '../../../components/FaqItem.astro';
import StickyQuote from '../../../components/StickyQuote.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import { models } from '../../../data/models';
import { productCategories } from '../../../data/site';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const category = productCategories.find((item) => item.slug === model.categorySlug)!;
const siblings = models.filter((item) => item.categorySlug === model.categorySlug && item.slug !== model.slug);
const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '제품', href: '/products' },
  { name: category.name, href: `/products/${category.slug}` },
  { name: model.sizeLabel, href: `/products/models/${model.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: model.name,
  description: model.summary,
  image: new URL(model.image, Astro.site).href,
  sku: model.slug.toUpperCase(),
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: model.family,
  additionalProperty: [
    { '@type': 'PropertyValue', name: '규격', value: model.sizeAr },
    { '@type': 'PropertyValue', name: '그릿 등급', value: model.gritRange.join(', ') },
    { '@type': 'PropertyValue', name: '베이스 종류', value: model.backing },
    { '@type': 'PropertyValue', name: '고정 방식', value: model.attachment },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: model.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${model.name} | 墨泰 연마재`}
  description={`墨泰의 ${model.name}: ${model.gritRange.length}개 그릿 등급 가용, 명확한 스펙과 도매 연마재. 규격과 등급에 맞춰 견적을 요청해 주십시오.`}
  image={model.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">{model.family} · 墨泰</span>
        <h1>{model.name}</h1>
        <p>{model.summary}</p>
        <ul class="hero__trust">
          <li>{model.gritRange.length}개 그릿 등급</li>
          <li>생산 전 스펙 확인</li>
          <li>도매 공급</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${model.slug}`}>견적 요청</a>
          <a class="button button--ghost" href="#grit">그릿 등급 확인</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={model.image} alt={model.imageAlt} width="680" height="510" />
        <figcaption>최소 수량(MOQ)과 상업 조건은 견적서에서 확정합니다.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">이 규격은 언제 적합할까요?</span>
          <h2>확정된 규격, 마감 공정을 커버하는 등급 구성</h2>
          <p>
            {model.summary} 올바른 규격 선택은 기종과 고정 방식의 호환 확인에서 시작하며, 이후
            가공 소재와 원하는 마감 결과에 따라 등급을 결정합니다.
          </p>
          <ul class="check-list check-list--large">
            <li>규격: <strong>{model.sizeAr}</strong></li>
            <li>베이스 종류: {model.backing}</li>
            <li>고정 방식: {model.attachment}</li>
          </ul>
        </div>

        <div class="content-block" id="grit">
          <span class="eyebrow">그릿 등급</span>
          <h2>당신의 단계에 맞는 등급은 무엇인가요?</h2>
          <p>
            이 규격에 대해 {model.gritRange.length}개 등급을 제공합니다. 정확한 선택은
            가공 소재, 압력, 이송 속도에 의존하므로, 필요 시 수량 확정 전 샘플을 보내 드립니다.
          </p>
          <ul class="grit-grid" aria-label="가용 그릿 등급">
            {model.gritRange.map((grit) => <li>{grit}</li>)}
          </ul>
          <div class="table-wrap">
            <table>
              <caption>{model.name}의 레퍼런스 스펙 요약. 최종 스펙은 구매자와 함께 검토합니다.</caption>
              <thead><tr><th>항목</th><th>설명</th></tr></thead>
              <tbody>
                <tr><th scope="row">규격</th><td>{model.sizeAr}</td></tr>
                <tr><th scope="row">그릿 등급</th><td>{model.gritRange.join(', ')}</td></tr>
                <tr><th scope="row">베이스 종류</th><td>{model.backing}</td></tr>
                <tr><th scope="row">고정 방식</th><td>{model.attachment}</td></tr>
                <tr><th scope="row">제품군</th><td>{model.family}</td></tr>
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            단가는 등급, 수량, 포장, 배송 목적지에 따라 달라집니다. 상세 스펙과 비용은
            견적서와 함께 발송합니다.
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">고려해야 할 사항</span>
          <h2>공급 성공을 좌우하는 3가지</h2>
          <ol class="selection-steps">
            {model.notes.map((note) => <li><p>{note}</p></li>)}
          </ol>
        </div>

        <div class="content-block">
          <span class="eyebrow">자주 묻는 질문</span>
          <h2>{model.name} 관련 질문</h2>
          <div class="faq-list">
            {model.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={model.name} />
        <div class="sidebar-card">
          <h3>주문에 유용한 정보</h3>
          <ul class="check-list">
            <li>규격: {model.sizeAr}</li>
            <li>필요 등급</li>
            <li>수량과 반복 주문 주기</li>
            <li>배송 목적지</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">그릿 가이드 보기 <span>→</span></a>
        </div>
        {
          siblings.length > 0 && (
            <div class="sidebar-card sidebar-card--soft">
              <h3>같은 제품군의 다른 규격</h3>
              <ul class="plain-links">
                {siblings.map((item) => (
                  <li><a href={`/products/models/${item.slug}`}>{item.name} →</a></li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">구매 맥락</span>
          <h2>주문 승인 전 규격 비교</h2>
        </div>
        <a class="button button--outline" href={`/products/${category.slug}`}>{category.name} 페이지</a>
      </div>
      <div class="related-grid">
        <a class="related-card" href={`/products/${category.slug}`}>
          <img src={category.image} alt="" width="320" height="220" loading="lazy" />
          <div>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
            <span>제품군 카탈로그 보기 →</span>
          </div>
        </a>
        <a class="related-card" href="/resources/abrasive-grit-guide">
          <img src="/images/grit-reference.png" alt="" width="320" height="220" loading="lazy" />
          <div><h3>그릿 등급 선택 가이드</h3><p>등급과 핵심 마감 작업을 연결하는 레퍼런스 테이블입니다.</p><span>가이드 읽기 →</span></div>
        </a>
        <a class="related-card" href="/quality">
          <img src="/images/converting.jpg" alt="" width="320" height="220" loading="lazy" />
          <div><h3>품질 보증</h3><p>변환 단계 전 스펙 확정 및 샘플 검사 단계.</p><span>검사 알아보기 →</span></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={model.categorySlug} />
    </div>
  </section>

  <CtaBand
    title={`${model.name} 견적 요청`}
    text="규격, 등급, 수량, 배송 목적지를 보내 주십시오. 스펙을 검토한 후 명확한 상업 견적을 준비해 드립니다."
  />
</Layout>
