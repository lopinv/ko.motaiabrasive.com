---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqItem from '../components/FaqItem.astro';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '기술 스펙', href: '/technical-specs' },
];

/*** FEPA P grit table (objective international standard) ***/
const fepaGrades = [
  { p: 'P40', range: '극도로 거침', use: '거친 소재의 빠른 제거' },
  { p: 'P60', range: '거침', use: '도막과 녹 제거' },
  { p: 'P80', range: '중간 거침', use: '마감 전 표면 준비' },
  { p: 'P100', range: '중간', use: '패널 1차 마감' },
  { p: 'P120', range: '중간 부드러움', use: '가장자리 연마' },
  { p: 'P150', range: '부드러움', use: '균일한 마감' },
  { p: 'P180', range: '부드러움', use: '도장 전 준비' },
  { p: 'P240', range: '매우 부드러움', use: '초기 마무리' },
  { p: 'P320', range: '세밀', use: '도료 층 사이 연마' },
  { p: 'P400', range: '세밀', use: '1차 광택 처리' },
  { p: 'P600', range: '매우 세밀', use: '금속 광택 처리' },
  { p: 'P800', range: '극세', use: '금속 최종 마감' },
  { p: 'P1000', range: '극세', use: '도막 광택 처리' },
  { p: 'P3000', range: '극세', use: '고광택 최종 광택 처리' },
  { p: 'P5000', range: '극세', use: '경면(거울) 광택 처리' },
];

/*** Unit conversions (objective) ***/
const unitConversions = [
  { from: '인치', to: 'mm', ratio: '1인치 = 25.4mm' },
  { from: '3인치', to: '75mm', ratio: '3 × 25.4' },
  { from: '4인치', to: '100mm', ratio: '4 × 25.4' },
  { from: '5인치', to: '125mm', ratio: '5 × 25.4' },
  { from: '6인치', to: '150mm', ratio: '6 × 25.4' },
];

/*** Backing types (industry fact) ***/
const backingTypes = [
  { type: '종이', desc: '유연하고 가볍으며, 평탄한 표면과 얇은 벨트에 적합합니다. 습기 저항은 제한적입니다.' },
  { type: '천 (면/폴리에스터)', desc: '내구성 있고 유연하며, 무거운 벨트와 금속 적용 분야에 적합합니다. 내열성이 있습니다.' },
  { type: '폴리머 섬유', desc: '높은 내구성과 인장·수분 저항을 가져, 무거운 산업 적용 분야에 사용됩니다.' },
  { type: '오픈 메시', desc: '연마 중 먼지 배출을 허용합니다. 메시 디스크에 사용됩니다.' },
];

const grainTypes = [
  { type: '알루미늄 산화물 (Al₂O₃)', desc: '가장 보편적입니다. 목재와 일반 금속에 적합하며 가격과 성능의 균형이 좋습니다.' },
  { type: '지르코니아 (ZrO₂)', desc: '더 강하고 수명이 깁니다. 강한 금속과 대용량 제거에 적합합니다.' },
  { type: '세라믹', desc: '최고의 성능을 발휘합니다. 미세 입자가 스스로 날카로워지며(셀프-슈어), 집중적인 산업 공정에 적합합니다.' },
  { type: '실리콘 카바이드 (SiC)', desc: '날카롭고 소모가 빠른 입자입니다. 석재, 유리, 최종 마감에 적합합니다.' },
];

const specFaq = [
  {
    q: 'FEPA P 등급과 CAMI 등급의 차이는 무엇인가요?',
    a: 'FEPA P는 유럽/국제 표준으로 세계 대부분 지역에서 채택되어 있고, CAMI는 미국 표준입니다. 두 표준의 번호가 완전히 일치하지는 않습니다(예: P120 ≈ CAMI 120이지만 P400 ≠ CAMI 400). 혼동을 피하기 위해 주문 시 FEPA P로 표기하는 것을 권장합니다.',
  },
  {
    q: '자재에 맞는 그릿 종류는 어떻게 선택하나요?',
    a: '목재와 일반 작업에는: 알루미늄 산화물. 강한 금속과 대용량 제거에는: 지르코니아. 고성능 산업 공정에는: 세라믹. 석재·유리·최종 마감에는: 실리콘 카바이드(SiC).',
  },
  {
    q: '제 적용 분야에 가장 적합한 베이스는 무엇인가요?',
    a: '평탄한 표면과 얇은 벨트에는: 종이. 무거운 벨트와 금속에는: 천. 습한 환경 또는 무거운 작업에는: 폴리머 섬유. 먼지 흡입이 동반된 연마에는: 오픈 메시.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: specFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="연마재 기술 스펙 | FEPA 등급표와 베이스·그릿 | 墨泰"
  description="포괄적인 기술 레퍼런스: FEPA P 등급 전체 테이블, 그릿 종류(알루미늄 산화물/지르코니아/세라믹/실리콘 카바이드), 베이스 종류, 인치/mm 환산표. 국제 산업 표준 기반의 객관 데이터."
  image="/images/grit-reference.png"
  breadcrumbs={breadcrumbs}
  jsonLd={[faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">기술 레퍼런스</span>
      <h1>연마재 기술 스펙</h1>
      <p>
        FEPA P 등급, 그릿과 베이스 종류, 단위 환산표 —
        견적을 요청하기 전에 정확한 스펙을 수립하는 데 도움이 되는 레퍼런스 테이블입니다.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">

      <div class="content-block">
        <span class="eyebrow">그릿 등급표</span>
        <h2>FEPA P 등급과 적용 분야</h2>
        <p>
          FEPA P 표준(Federation of European Producers of Abrasives)은 그릿 거칠기 번호에
          사용되는 국제 표준입니다. 숫자가 클수록 그릿이 부드러워집니다.
        </p>
        <div class="table-wrap">
          <table>
            <caption>P40부터 P5000까지의 일반적인 FEPA P 등급 레퍼런스 테이블</caption>
            <thead>
              <tr><th scope="col">등급</th><th scope="col">거칠기</th><th scope="col">표준 적용 분야</th></tr>
            </thead>
            <tbody>
              {fepaGrades.map((g) => (
                <tr><th scope="row" class="mono">{g.p}</th><td>{g.range}</td><td>{g.use}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="content-block">
        <span class="eyebrow">단위 환산</span>
        <h2>인치 → mm 환산</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">지름 (인치)</th><th scope="col">지름 (mm)</th><th scope="col">계산</th></tr></thead>
            <tbody>
              {unitConversions.map((u) => (
                <tr><th scope="row">{u.from}</th><td class="mono">{u.to}</td><td>{u.ratio}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="content-block">
        <span class="eyebrow">그릿 종류</span>
        <h2>연마 입자의 4가지 주요 종류</h2>
        <div class="knowledge-hub__grid">
          {grainTypes.map((g) => (
            <div class="sidebar-card">
              <strong>{g.type}</strong>
              <p>{g.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="content-block">
        <span class="eyebrow">베이스 종류</span>
        <h2>벨트와 디스크의 베이스</h2>
        <div class="knowledge-hub__grid">
          {backingTypes.map((b) => (
            <div class="sidebar-card">
              <strong>{b.type}</strong>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="content-block">
        <span class="eyebrow">자주 묻는 질문</span>
        <h2>스펙 관련 기술 질문</h2>
        <div class="faq-list">
          {specFaq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="이 레퍼런스를 사용해 스펙을 확정하세요"
    text="위의 테이블에서 등급, 그릿 종류, 베이스를 선택한 후 견적 양식으로 보내 주시면 정확한 단가로 안내해 드립니다."
  />
</Layout>
