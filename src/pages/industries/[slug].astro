---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqItem from '../../components/FaqItem.astro';
import StickyQuote from '../../components/StickyQuote.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { industries, productCategories } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const recommended = productCategories.filter((product) => (industry.products as readonly string[]).includes(product.slug));
const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '산업', href: '/industries' },
  { name: industry.name, href: `/industries/${industry.slug}` },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: industry.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${industry.title} | 墨泰 산업 솔루션`}
  description={`墨泰의 ${industry.name} 연마 솔루션: 가공 과제, 추천 제품, 스펙 선택 단계, 견적 요청 준비 정보.`}
  image={industry.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-hero page-hero--image">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">{industry.name} 분야 솔루션</span>
      <h1>{industry.title}</h1>
      <p>{industry.description}</p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container solution-layout">
      <div class="solution-main">
        <div class="content-block">
          <span class="eyebrow">가공 과제</span>
          <h2>이 분야에서 연마재 선택이 어려운 이유</h2>
          <p>
            최종 제품 품질은 처음부터 마무리까지의 연마 공정(샌딩/그라인딩) 균일성에 의존합니다.
            그래서 범용 공구를 보내는 데 그치지 않고, 가공 과제를 확인한 후 적합한 연마재,
            공구 형식, 등급으로 연결합니다.
          </p>
          <div class="challenge-list">
            {
              industry.challenges.map((challenge, index) => (
                <div><span>0{index + 1}</span><p>{challenge}</p></div>
              ))
            }
          </div>
        </div>

        <div class="content-block">
          <span class="eyebrow">선택 플랜</span>
          <h2>적합한 스펙을 어떻게 결정하나요?</h2>
          <ol class="selection-steps">
            <li><strong>가공 표면 확인</strong><p>목재 또는 금속 종류, 표면 상태, 잔재물 또는 가공 결함을 파악합니다.</p></li>
            <li><strong>가공 방식 검토</strong><p>기종, 고정 방식, 압력 및 이동 속도를 검토합니다.</p></li>
            <li><strong>소재와 등급 선택</strong><p>제거 또는 마감 단계에 맞는 그릿 종류와 등급을 결정합니다.</p></li>
            <li><strong>샘플 테스트</strong><p>상업적 수량 확정 전 샘플 발송 또는 적합성 검토가 가능합니다.</p></li>
          </ol>
        </div>

        <div class="content-block">
          <span class="eyebrow">자주 묻는 질문</span>
          <h2>{industry.name} 가공 관련 질문</h2>
          <div class="faq-list">
            {industry.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="solution-sidebar">
        <StickyQuote application={industry.name} />
        <div class="sidebar-card">
          <h3>추천 제품</h3>
          <ul class="sidebar-products">
            {
              recommended.map((product) => (
                <li>
                  <a href={`/products/${product.slug}`}>
                    <img src={product.image} alt="" width="72" height="54" loading="lazy" />
                    <span><strong>{product.name}</strong><small>스펙 보기 →</small></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="sidebar-card sidebar-card--soft">
          <h3>견적 요청 전</h3>
          <p>가공 소재 종류, 기종, 필요 규격, 수량 및 배송 목적지를 보내 주십시오.</p>
          <a class="text-link" href="/resources/abrasive-grit-guide">그릿 등급 선택 가이드 <span>→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">다른 분야 솔루션</span>
          <h2>다른 분야의 솔루션을 둘러보세요</h2>
        </div>
        <a class="button button--outline" href="/industries">전체 솔루션 보기</a>
      </div>
      <div class="related-grid">
        {
          industries
            .filter((item) => item.slug !== industry.slug)
            .map((item) => (
              <a class="related-card" href={`/industries/${item.slug}`}>
                <img src={item.image} alt="" width="320" height="220" loading="lazy" />
                <div><h3>{item.name}</h3><p>{item.description}</p><span>솔루션 보기 →</span></div>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles industry={industry.slug} />
    </div>
  </section>

  <CtaBand
    title={`${industry.name}용 샌딩 솔루션 설계하기`}
    text="문제가 되는 공정을 설명해 주십시오. 스펙을 검토한 후 적합한 연마재와 테스트를 제안해 드립니다."
  />
</Layout>
