---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries } from '../../data/site';
---

<Layout
  title="산업 분야별 샌딩 솔루션 | 墨泰"
  description="목공, 금속 마감, 자동차 보수를 위한 연마재 솔루션. 각 분야의 과제를 확인하고 적합한 제품·적용 분야의 추천 사항을 살펴보세요."
  image="/images/workshop.jpg"
>
  <section class="page-hero page-hero--industries">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">용도별 솔루션</span>
      <h1>제품 이름이 아니라 가공 과제를 먼저 확인하세요</h1>
      <p>
        각 분야마다 가공 소재와 작업 방식이 다릅니다. 원하는 표면, 공정, 적합한 공구를 연결하여
        생산 라인에서 바로 적용 가능한 추천을 제공합니다.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="industry-list">
        {
          industries.map((industry, index) => (
            <article class="industry-row">
              <div class="industry-row__media">
                <img src={industry.image} alt="" width="520" height="360" loading="lazy" />
                <span>0{index + 1}</span>
              </div>
              <div class="industry-row__content">
                <span class="eyebrow">{industry.name} 분야</span>
                <h2><a href={`/industries/${industry.slug}`}>{industry.title}</a></h2>
                <p>{industry.description}</p>
                <h3>분야별 주요 과제</h3>
                <ul class="check-list">
                  {industry.challenges.map((challenge) => <li>{challenge}</li>)}
                </ul>
                <a class="button button--outline button--small" href={`/industries/${industry.slug}`}>
                  솔루션 및 연마재 상세 보기
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="catalog-guide">
        <div>
          <span class="eyebrow">특수 요청</span>
          <h2>언급되지 않은 적용 분야가 있으신가요?</h2>
          <p>
            자동차 또는 정밀 공구와 같은 다른 분야에서도 동일한 방식으로 스펙을 결정할 수 있습니다.
            작업 내용을 보내 주시면 가장 적합한 옵션을 안내해 드립니다.
          </p>
        </div>
        <div class="catalog-guide__actions">
          <a class="button button--primary" href="/quote">요청 내용 보내기</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="실제 작업부터 시작해 보세요"
    text="가공 소재, 기종, 원하는 마감 결과만으로 시작할 수 있습니다. 공급 가능한 스펙으로 전환하는 데 도움을 드립니다."
  />
</Layout>
