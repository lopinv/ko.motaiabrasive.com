---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { resources } from '../../data/site';
---

<Layout
  title="기술 리소스 및 연마재 공급 가이드 | 墨泰"
  description="그릿 등급 선택과 OEM·포장 주문 준비를 위한 실무 가이드. 연마재 구매자가 견적을 요청하기 전에 정확한 스펙을 수립하도록 돕는 기술 리소스입니다."
  image="/images/grit-reference.png"
>
  <section class="page-hero page-hero--resources">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">리소스 센터</span>
      <h1>더 나은 주문을 준비하는 데 도움이 되는 기술 지식</h1>
      <p>
        구매팀과 운영자를 위한 실무 가이드: 스펙 수립 정보, 옵션 비교, 그리고 문의를 명확한
        견적으로 전환하기 위해 필요한 사항을 설명합니다.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="resource-grid">
        {
          resources.map((resource) => (
            <article class="resource-card">
              <a class="resource-card__media" href={`/resources/${resource.slug}`}>
                <img src={resource.image} alt="" width="520" height="340" loading="lazy" />
                <span>{resource.type}</span>
              </a>
              <div class="resource-card__body">
                <h2><a href={`/resources/${resource.slug}`}>{resource.title}</a></h2>
                <p>{resource.description}</p>
                <ul class="resource-card__topics">
                  {resource.sections.map((section) => <li>{section.title}</li>)}
                </ul>
                <a class="text-link" href={`/resources/${resource.slug}`}>가이드 읽기 <span>→</span></a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="knowledge-hub">
        <div class="knowledge-hub__intro">
          <span class="eyebrow">지식 센터</span>
          <h2>정보에서 구매 가능한 스펙까지</h2>
          <p>
            문의를 이 순서로 정리하세요: 제품 정의, 작업 방식, 수량과 목적지.
            이 정보가 있으면 견적 비교가 더 빠르고 명확해집니다.
          </p>
        </div>
        <div class="knowledge-hub__grid">
          <a href="/products/abrasive-belts"><strong>벨트 레퍼런스</strong><span>규격 및 고정 방식 →</span></a>
          <a href="/products/flap-discs"><strong>디스크 레퍼런스</strong><span>지름 및 베이스 →</span></a>
          <a href="/industries"><strong>산업 분야 레퍼런스</strong><span>용도별 추천 →</span></a>
          <a href="/quality"><strong>검사 레퍼런스</strong><span>로트 검토 포인트 →</span></a>
          <a href="/technical-specs"><strong>기술 스펙</strong><span>FEPA 표 및 베이스 →</span></a>
          <a href="/shipping-oem"><strong>공급 및 OEM</strong><span>운송 및 포장 단계 →</span></a>
          <a href="/articles"><strong>기술 기사</strong><span>{`지식 라이브러리 →`}</span></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="가이드를 견적으로 전환하기" text="준비하신 스펙을 보내 주시면, 검토 후 적합한 조건으로 회신드립니다." />
</Layout>
