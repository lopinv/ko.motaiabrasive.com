---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqItem from '../components/FaqItem.astro';
import { qualitySteps } from '../data/site';

const qualityFaq = [
  {
    q: '배송 전에 무엇을 검사하나요?',
    a: '구매자와 확정된 스펙에 따라 제품 구조, 규격, 그릿 종류, 고정 방식, 포장을 점검합니다. 상세 검사 항목은 제품과 주문에 따라 달라집니다.',
  },
  {
    q: '자체 검사 기준을 적용할 수 있나요?',
    a: '네. 스펙 단계에서 검사 요건을 검토하고, 생산 승인 전 공정 내에서 적용 가능한 범위를 명확히 안내해 드립니다.',
  },
  {
    q: '보고서나 인증서가 제공되나요?',
    a: '각 스펙·주문별 가용 문서를 안내해 드립니다. 검증되지 않은 인증이나 주장은 게시하지 않으며, 특별 요건은 주문 검토 시 확인해 드립니다.',
  },
  {
    q: '샘플 적합성은 어떻게 확인하나요?',
    a: '확정된 스펙대로 샘플을 보내드리고, 최종 수량 결정 전 가공 결과와 검사 결과를 구매자 피드백으로 기록합니다.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qualityFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="연마재 품질 보증 및 검사 | 墨泰"
  description="墨泰 연마재의 품질 관리 단계를 확인하세요: 스펙 확정, 샘플 검사, 변환, 재검사 및 포장, 그리고 구매자와 함께하는 출하 적합성 절차."
  image="/images/converting.jpg"
  jsonLd={[faqJsonLd]}
>
  <section class="page-hero page-hero--image">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">품질 보증</span>
      <h1>품질은 마지막 단계가 아니라 스펙에서 시작됩니다</h1>
      <p>
        구매자와 요건을 검토하고, 샘플을 기록하며, 출하 전 제품을 검사합니다. 이 방식은
        모든 로트의 적합성을 이해하고 추적할 수 있게 합니다.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="quality-intro">
        <div>
          <span class="eyebrow">검사 방법론</span>
          <h2>주문부터 출하까지 5개 점검 포인트</h2>
          <p>
            구매자에게 복잡한 관리 시스템을 요구하지 않습니다. 규격 불일치, 고정 방식 부적합,
            그릿 등급 또는 포장 종류 오류 같은 일반적인 실수를 막는 실무적인 점검 포인트에
            초점을 맞춥니다.
          </p>
        </div>
        <div class="quality-intro__aside">
          <strong>중요 참고</strong>
          <p>
            미공개 인증과 등록은 특징으로 제시하지 않습니다. 구매자가 요청하는 규정 또는
            인증은 유효성을 확인한 후 견적에 명시합니다.
          </p>
        </div>
      </div>

      <div class="quality-steps">
        {
          qualitySteps.map((step, index) => (
            <article class="quality-step">
              <span class="quality-step__number">{String(index + 1).padStart(2, '0')}</span>
              <div><h2>{step.title}</h2><p>{step.text}</p></div>
              <div class="quality-step__check"><span>검토</span></div>
            </article>
          ))
        }
      </div>

      <div class="content-block checklist-block">
        <span class="eyebrow">주문 승인 전 체크리스트</span>
        <h2>적합성 오류를 줄이는 정보</h2>
        <div class="checklist-grid">
          <div><strong>제품 정의</strong><ul class="check-list"><li>명칭과 종류</li><li>규격 또는 지름</li><li>등급과 소재</li></ul></div>
          <div><strong>가공</strong><ul class="check-list"><li>기종</li><li>고정 방식</li><li>가공 소재</li></ul></div>
          <div><strong>공급</strong><ul class="check-list"><li>수량</li><li>포장과 브랜드</li><li>목적지와 출하 일정</li></ul></div>
          <div><strong>검사</strong><ul class="check-list"><li>샘플 요건</li><li>수용 기준</li><li>로트 문서</li></ul></div>
        </div>
      </div>

      <div class="content-block">
        <span class="eyebrow">자주 묻는 질문</span>
        <h2>품질과 적합성에 관한 질문</h2>
        <div class="faq-list">
          {qualityFaq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="프로젝트에 맞는 검사 스펙을 요청하세요"
    text="로트, 샘플, 포장 요건을 알려 주십시오. 검토 후 주문 승인 단계에 반영해 드립니다."
  />
</Layout>
