---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '주문 확인', href: '/thankyou' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '주문 확인 — 墨泰',
  description:
    '견적 요청이 접수되었습니다. 墨泰 팀이 스펙을 검토한 후 선택하신 채널로 1영업일 이내에 회신합니다.',
};
---

<Layout
  title="주문 확인 — 墨泰"
  description="견적 요청이 접수되었습니다. 墨泰 팀이 스펙을 검토한 후 선택하신 채널(WhatsApp 또는 이메일 또는 전화)로 1영업일 이내에 회신합니다."
  image="/images/factory.jpg"
  jsonLd={[jsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section thankyou">
    <div class="container thankyou__inner" data-reveal>
      <div class="thankyou__card" data-thanks-card>
        <span class="thankyou__badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.4-4.6-4.6 1.5-1.5 3.1 3.1 6.5-6.5 1.5 1.5-8 7.9Z"
            ></path>
          </svg>
        </span>
        <h1>견적 요청을 접수했습니다</h1>
        <p>
          연락해 주셔서 감사합니다. 墨泰 팀이 스펙을 검토하며, 필요 시 간단한 기술 질문을 드린 후
          선택하신 채널로 1영업일 이내에 상업 견적을 보내 드립니다.
        </p>

        <div class="thankyou__next" data-thankyou-next hidden>
          <span class="eyebrow">출처로 돌아가기</span>
          <a class="button button--outline" href="/" data-return-link>원래 페이지로 돌아가기</a>
        </div>
      </div>

      <div class="thankyou__pipeline">
        <h2>제출 후 어떤 절차가 진행되나요?</h2>
        <ol class="funnel-pipeline">
          <li>
            <strong>1차 검토</strong>
            <span>스펙 완료 여부를 확인하고, 필요 시 간단한 기술 질문을 드립니다.</span>
          </li>
          <li>
            <strong>상업 견적</strong>
            <span>단가, 최소 주문 수량(MOQ), 포장·공급 조건 안내.</span>
          </li>
          <li>
            <strong>샘플 / 제안</strong>
            <span>샘플 또는 인증서가 필요하시면 절차 내에서 준비해 드립니다.</span>
          </li>
        </ol>
      </div>

      <div class="thankyou__actions">
        <a class="button button--accent" href="/quote">추가 견적 요청</a>
        <a
          class="button button--whatsapp"
          href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('墨泰 팀, 견적 요청을 제출했습니다. 진행 상황을 확인하고 싶습니다.')}`}
          target="_blank"
          rel="noopener nofollow"
        >
          WhatsApp으로 추적
        </a>
      </div>
    </div>
  </section>

  <script>
    // 제출 후 이동 시 ?from=<출처 페이지> 포함(폼 JS가 _next에 기록); 같은 도메인 검증 후 "출처 페이지로 돌아가기" 링크 활성화,
    // 오픈 리다이렉트 방지
    const from = new URLSearchParams(location.search).get('from') || '';
    let safe = '';
    if (from) {
      try {
        const u = new URL(from, location.origin);
        if (u.origin === location.origin) safe = u.pathname + u.search;
      } catch {
        safe = '';
      }
    }
    const box = document.querySelector<HTMLElement>('[data-thankyou-next]');
    const link = document.querySelector<HTMLAnchorElement>('[data-return-link]');
    if (box && link && safe) {
      link.href = safe;
      box.hidden = false;
    }
  </script>
</Layout>
