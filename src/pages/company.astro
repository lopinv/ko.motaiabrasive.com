---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, qualitySteps, companyFacts } from '../data/site';
import LocationMap from '../components/LocationMap.astro';
---

<Layout
  title="墨泰 연마재 공장 소개 | 중국 산업용 도구 공급 기업"
  description="중국 후베이 墨泰 연마재를 소개합니다: 샌딩 벨트, 디스크, 샌딩 스펀지 직영 공급. 산업 구매자를 위한 상업적 공급 및 OEM 주문 지원."
  image="/images/factory.jpg"
>
  <section class="page-hero page-hero--image">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">墨泰 소개</span>
      <h1>중국 후베이 제조 벨트 중심의 산업 직영 공급업체</h1>
      <p>
        명확한 스펙, 직접 소통, 문의부터 배송까지 체계적인 준비 프로세스를 바탕으로 산업
        구매자·수입상·유통업자를 지원합니다.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="story-grid">
        <div class="story-grid__content">
          <span class="eyebrow">회사 개요</span>
          <h2>명확한 스펙에서 시작하는 거래</h2>
          <p>
            고객마다 동일한 설명을 사용하지 않습니다. 소재 종류, 작업 방식, 규격,
            수량을 검토한 후 필요한 제품·스펙·서비스를 함께 결정합니다.
          </p>
        </div>
        <div class="story-grid__media">
          <img src="/images/workshop.jpg" alt="墨泰 공장 내 작업장" width="720" height="520" loading="lazy" />
        </div>
      </div>

      <div class="fact-grid">
        {
          companyFacts.map((fact) => (
            <div class="fact-card"><strong>{fact.value}</strong><span>{fact.label}</span></div>
          ))
        }
      </div>

      <div class="company-values">
        <div class="company-values__intro">
          <span class="eyebrow">운영 방식</span>
          <h2>모든 주문을 관통하는 3가지 원칙</h2>
          <p>목표는 가장 빠른 제품 발송이 아니라, 반복 가능하고 신뢰할 수 있게 공급할 수 있는 스펙을 확정한 것입니다.</p>
        </div>
        <div class="value-list">
          <article><span>01</span><h3>거래 전에 스펙 확정</h3><p>변환 단계 전 규격·등급·베이스·수량·포장을 모두 확정합니다.</p></article>
          <article><span>02</span><h3>필요할 때 샘플</h3><p>구매자는 상업적 수량을 확정하기 전에 실제 작업 환경에서 샘플을 테스트할 수 있습니다.</p></article>
          <article><span>03</span><h3>구매자와의 소통</h3><p>구매팀과 직접 연결 채널을 유지하여 문의 이후의 추적을 빠르게 진행합니다.</p></article>
        </div>
      </div>

      <div class="content-block company-process">
        <span class="eyebrow">실행 경로</span>
        <h2>문의부터 배송까지 5단계</h2>
        <div class="process-cards">
          {
            qualitySteps.map((step, index) => (
              <article class="process-card"><span class="process-card__number">{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.text}</p></article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--band-3 company-contact-band">
    <div class="container company-contact-band__grid">
      <div>
        <span class="eyebrow eyebrow--light">공장 방문</span>
        <h2>공장을 직접 방문하거나, 일정을 조율하세요</h2>
        <p>약속 시간과 필요 정보를 소통팀과 확인한 후 공장 방문을 조율할 수 있습니다.</p>
      </div>
      <div class="company-contact-band__data">
        <div><span>이메일</span><a href={`mailto:${SITE.email}`} dir="ltr">{SITE.email}</a></div>
        <div><span>전화 및 WhatsApp</span><a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener nofollow" dir="ltr">{SITE.phone}</a></div>
        <div><span>위치</span><address>{SITE.addressAr}</address></div>
      </div>
    </div>
  </section>

  <LocationMap />

  <CtaBand
    title="墨泰를 공급업체로 등록하기 시작하기"
    text="스펙이나 샘플 요청을 보내 주십시오. 필요한 정보와 가장 적합한 상업적 해결책을 안내해 드리겠습니다."
  />
</Layout>
